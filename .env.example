# Remote ESG connection (the fixture reads these).
# Provide the host with credentials in the URL. ZEBRUNNER_HUB_URL wins when both are set.
REMOTE_HOST=https://user:password@engine.zebrunner.dev

# Zebrunner session capabilities (zebrunner:options). Playwright uses min 1024 CPU and 2048 MB.
REMOTE_BROWSER_CPU=2048
REMOTE_BROWSER_MEMORY=2048
REMOTE_BROWSER_ENABLE_VIDEO=true
#REMOTE_IDLE_TIMEOUT=300

#REMOTE_BROWSER_ENABLE_VNC=true
#REMOTE_BROWSER_ENABLE_LOG=true
#REMOTE_BROWSER_ENABLE_DEBUG=false
#REMOTE_MAX_TIMEOUT=3600 # Maximum timeout for the session, in seconds.
#REMOTE_BROWSER_SCREEN_RESOLUTION=1920x1080x24
#REMOTE_BROWSER_VIDEO_SCREEN_SIZE=1920x1080
#REMOTE_BROWSER_FRAME_RATE=12
#REMOTE_BROWSER_TIME_ZONE=UTC

# Fixture timeouts (milliseconds).
REMOTE_SESSION_CREATE_TIMEOUT_MS=600000
REMOTE_PLAYWRIGHT_REFRESH_TIMEOUT_MS=150000

# Runner.
TEST_TIMEOUT_MS=120000
WORKERS=1
RETRIES=0

REPORTING_ENABLED=true
REPORTING_PROJECT_KEY=DEF
REPORTING_SERVER_HOSTNAME=
REPORTING_SERVER_ACCESS_TOKEN=
REPORTING_LAUNCH_DISPLAY_NAME=Playwright on ESG
REPORTING_LAUNCH_BUILD=1.0.0
REPORTING_LAUNCH_ENVIRONMENT=grid
REPORTING_LOGS_FLUSH_INTERVAL_MS=1000
