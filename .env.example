ESG_HOST=
ESG_USER=
ESG_PASSWORD=
# Zebrunner launcher can set ZEBRUNNER_HUB_URL instead of ESG_HOST, ESG_USER, and ESG_PASSWORD.

# Playwright platform session.
ESG_PLAYWRIGHT_BROWSER_NAME=chromium
ESG_PLAYWRIGHT_HEADLESS=false
# ESG_PLAYWRIGHT_VERSION defaults to the installed @playwright/test version.
# ESG_PLAYWRIGHT_VERSION=1.58.2
# Engine after the refresh. Default is ESG_PLAYWRIGHT_BROWSER_NAME.
# ESG_PLAYWRIGHT_REFRESH_BROWSER_NAME=firefox

# Zebrunner session capabilities (zebrunner:options). Playwright uses min 1024 CPU and 2048 MB.
ESG_CPU=2048
ESG_MEMORY=2048
ESG_ENABLE_VIDEO=true
ESG_ENABLE_VNC=true
ESG_ENABLE_LOG=true
ESG_ENABLE_DEBUG=false
ESG_IDLE_TIMEOUT=300
ESG_MAX_TIMEOUT=3600
ESG_SCREEN_RESOLUTION=1920x1080x24
ESG_VIDEO_SCREEN_SIZE=1920x1080
ESG_FRAME_RATE=12
ESG_TIME_ZONE=UTC

ESG_SESSION_CREATE_TIMEOUT_MS=600000
ESG_PLAYWRIGHT_REFRESH_TIMEOUT_MS=150000
ESG_STEP_PAUSE_MS=5000

# Runner.
ESG_TEST_TIMEOUT_MS=120000
ESG_WORKERS=1
ESG_RETRIES=0

REPORTING_ENABLED=true
REPORTING_PROJECT_KEY=DEF
REPORTING_SERVER_HOSTNAME=
REPORTING_SERVER_ACCESS_TOKEN=
REPORTING_LAUNCH_DISPLAY_NAME=Playwright on ESG
REPORTING_LAUNCH_BUILD=1.0.0
REPORTING_LAUNCH_ENVIRONMENT=grid
REPORTING_LOGS_FLUSH_INTERVAL_MS=1000
