    "test:refresh-isolation": "playwright test playwright-on-esg-refresh-isolation.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^24.9.2",
    "typescript": "^5.9.2"
  },
